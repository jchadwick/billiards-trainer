{
  "coordinate_space": "pixel",
  "source_resolution": [640, 360],
  "coordinate_scale": [6.0, 6.0],
  "detection_method": "combined",
  "hough_circles": {
    "dp": 1.0,
    "min_dist_ratio": 0.8,
    "param1": 50,
    "param2": 30
  },
  "size_constraints": {
    "min_radius": 15,
    "max_radius": 26,
    "expected_radius": 20,
    "radius_tolerance": 0.3
  },
  "quality_filters": {
    "min_circularity": 0.75,
    "min_confidence": 0.4,
    "max_overlap_ratio": 0.3
  },
  "performance": {
    "roi_enabled": true,
    "roi_margin": 50
  },
  "background_subtraction": {
    "enabled": true,
    "threshold": 30
  },
  "debug": {
    "debug_mode": false
  }
}
