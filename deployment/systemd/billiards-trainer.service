[Unit]
Description=Billiards Trainer System
Documentation=https://github.com/billiards-trainer/docs
After=network.target

[Service]
Type=simple
User=billiards
Group=billiards
WorkingDirectory=/opt/billiards-trainer
SupplementaryGroups=video
Environment=BILLIARDS_ENV=production
EnvironmentFile=-/etc/billiards-trainer.env

ExecStartPre=/bin/mkdir -p /opt/billiards-trainer/logs
ExecStartPre=/bin/chown billiards:billiards /opt/billiards-trainer/logs

ExecStart=/opt/billiards-trainer/bin/billiards-server \
    --http-bind 0.0.0.0 \
    --http-port 8000 \
    --scene-bind 127.0.0.1 \
    --scene-port 49321 \
    --config /opt/billiards-trainer/config/production.json \
    --project-root /opt/billiards-trainer \
    --web-root /opt/billiards-trainer/frontend/web/dist \
    --start-live \
    --live-executable /opt/billiards-trainer/bin/billiards-perception-live \
    --capture-helper-executable /opt/billiards-trainer/bin/billiards-perception-gstreamer-probe

ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

Restart=always
RestartSec=10
StartLimitInterval=60
StartLimitBurst=3

# Security settings
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
PrivateDevices=false
ReadWritePaths=/opt/billiards-trainer/logs /opt/billiards-trainer/data /opt/billiards-trainer/config /opt/billiards-trainer/backend/calibration_data

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=billiards-trainer

[Install]
WantedBy=multi-user.target
