{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:billiards-trainer:perception:public-state-delivery:v2",
  "title": "Billiards Rust public-state delivery v2",
  "description": "Self-contained phase and cue evidence paired with an optional raw localization snapshot and retained public state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["delivery_type", "delivery_schema_version", "delivery_sequence", "engine_instance_id", "source_session_id", "source_snapshot", "current_state", "perception"],
  "properties": {
    "delivery_type": { "const": "billiards_public_state_delivery" },
    "delivery_schema_version": { "const": 2 },
    "delivery_sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "engine_instance_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_snapshot": { "type": ["object", "null"] },
    "current_state": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "public-state-delivery-v1.schema.json#/$defs/currentState" }
      ]
    },
    "perception": { "$ref": "#/$defs/perception" }
  },
  "$defs": {
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shaft_start_px", "shaft_end_px", "axis_unit", "confidence", "observation_age_ms", "signed_direction"],
      "properties": {
        "shaft_start_px": { "$ref": "#/$defs/point" },
        "shaft_end_px": { "$ref": "#/$defs/point" },
        "axis_unit": { "$ref": "#/$defs/point" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "observation_age_ms": { "type": "integer", "minimum": 0 },
        "signed_direction": { "enum": ["toward_start", "toward_end", null] },
        "source_frame_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 }
      }
    },
    "point": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "maxItems": 2
    },
    "perception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_sequence", "image_width_px", "image_height_px", "phase", "layout_revision", "layout_trusted", "empty_layout_verified", "guidance_valid", "trust_reason", "last_ball_observation_age_ms", "latest_motion_check_age_ms", "cue_evidence_age_ms", "motion_evidence_max_age_ms", "cue_evidence_max_age_ms", "layout_verification_max_age_ms", "cue"],
      "properties": {
        "event_sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "image_width_px": { "type": ["integer", "null"], "minimum": 1 },
        "image_height_px": { "type": ["integer", "null"], "minimum": 1 },
        "phase": { "enum": ["recovering", "pre_shot", "aiming", "shot_underway"] },
        "layout_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "layout_trusted": { "type": "boolean" },
        "empty_layout_verified": { "type": "boolean", "description": "True only after quiet dwell and the configured count of consistent successful empty full-table observations." },
        "guidance_valid": { "type": "boolean" },
        "trust_reason": { "type": "string", "minLength": 1, "maxLength": 128 },
        "last_ball_observation_age_ms": { "type": ["integer", "null"], "minimum": 0 },
        "latest_motion_check_age_ms": { "type": ["integer", "null"], "minimum": 0 },
        "cue_evidence_age_ms": { "type": ["integer", "null"], "minimum": 0 },
        "motion_evidence_max_age_ms": { "type": "integer", "minimum": 1 },
        "cue_evidence_max_age_ms": { "type": "integer", "minimum": 1 },
        "layout_verification_max_age_ms": { "type": "integer", "minimum": 1 },
        "cue": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/cue" }] },
        "decision_frame_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "decision_calibration_revision": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
        "decision_rectification_revision": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
        "table_visibility": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "reason", "observation_frame_id", "observation_age_ms"],
              "properties": {
                "status": { "enum": ["visible", "not_visible", "unknown"] },
                "reason": { "type": "string", "minLength": 1, "maxLength": 128 },
                "observation_frame_id": { "type": "string", "minLength": 1, "maxLength": 128 },
                "observation_age_ms": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
              }
            }
          ]
        }
      }
    }
  }
}
