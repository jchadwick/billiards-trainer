{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://billiards-trainer.local/contracts/calibration/v1/ball-center-calibration-input.schema.json",
  "title": "Verified ball-center calibration input v1",
  "description": "Independent 2D image/table center correspondences for billiards-perception-ball-center-calibrate. The input must describe the exact camera, optics, refiner, table, image space, and source geometry used to collect the image points.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "calibration_revision",
    "camera_profile_id",
    "optics_profile_id",
    "optics_revision",
    "refiner_revision",
    "table_revision",
    "rectification_revision",
    "image_space",
    "source_width_px",
    "source_height_px",
    "table_width_mm",
    "table_height_mm",
    "ball_diameter_mm",
    "provenance",
    "correspondences"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "calibration_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "camera_profile_id": { "$ref": "#/$defs/identifier" },
    "optics_profile_id": { "$ref": "#/$defs/identifier" },
    "optics_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "refiner_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "table_revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "rectification_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "image_space": { "const": "raw" },
    "source_width_px": { "type": "integer", "minimum": 2 },
    "source_height_px": { "type": "integer", "minimum": 2 },
    "table_width_mm": { "const": 2336.8 },
    "table_height_mm": { "const": 1155.7 },
    "ball_diameter_mm": { "const": 57.15 },
    "provenance": { "$ref": "#/$defs/provenance" },
    "solver_policy": { "$ref": "#/$defs/solverPolicy" },
    "correspondences": {
      "type": "array",
      "minItems": 6,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/correspondence" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "provenance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "imagePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x_px", "y_px"],
      "properties": {
        "x_px": { "type": "number" },
        "y_px": { "type": "number" }
      }
    },
    "tablePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x_mm", "y_mm"],
      "properties": {
        "x_mm": { "type": "number", "minimum": -1168.4, "maximum": 1168.4 },
        "y_mm": { "type": "number", "minimum": -577.85, "maximum": 577.85 }
      }
    },
    "correspondence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_point_px", "center_table_mm", "provenance"],
      "properties": {
        "image_point_px": { "$ref": "#/$defs/imagePoint" },
        "center_table_mm": { "$ref": "#/$defs/tablePoint" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "solverPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_correspondences",
        "maximum_correspondences",
        "relative_rank_tolerance",
        "maximum_condition_number",
        "numerical_tolerance",
        "maximum_fit_rms_mm"
      ],
      "properties": {
        "minimum_correspondences": { "type": "integer", "minimum": 6, "maximum": 4096 },
        "maximum_correspondences": { "type": "integer", "minimum": 6, "maximum": 4096 },
        "relative_rank_tolerance": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "maximum_condition_number": { "type": "number", "minimum": 1 },
        "numerical_tolerance": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "maximum_fit_rms_mm": { "type": ["number", "null"], "exclusiveMinimum": 0 }
      }
    }
  }
}
